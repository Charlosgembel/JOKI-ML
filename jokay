            const pinModal = document.getElementById('pinModal');
            const pinInput = document.getElementById('pinInput');
            const btnSubmitPin = document.getElementById('btnSubmitPin');
            const pinError = document.getElementById('pinError');
            const adminDashboardSection = document.getElementById('adminDashboardSection');
            const btnClosePinModal = document.getElementById('closePinModal');
            const btnCloseAdmin = document.getElementById('btnCloseAdmin');

            function openAdminDashboard() {
                pinModal.classList.remove('hidden');
                pinInput.focus();
                pinError.classList.add('hidden');
            }

            document.getElementById('navAdminBtn').addEventListener('click', openAdminDashboard);
            document.getElementById('mobileAdminBtn').addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                openAdminDashboard();
            });

            btnClosePinModal.addEventListener('click', () => pinModal.classList.add('hidden'));

            btnSubmitPin.addEventListener('click', function() {
                if (pinInput.value === DEFAULT_PIN) {
                    pinModal.classList.add('hidden');
                    pinInput.value = '';
                    adminDashboardSection.classList.remove('hidden');
                    renderRecapTable();
                    adminDashboardSection.scrollIntoView({ behavior: 'smooth' });
                } else {
                    pinError.classList.remove('hidden');
                }
            });

            btnCloseAdmin.addEventListener('click', function() {
                adminDashboardSection.classList.add('hidden');
                document.getElementById('hero').scrollIntoView({ behavior: 'smooth' });
            });

            // Initial calculation
            calculatePrice();

            // --- MOBILE MENU TOGGLE ---
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIcon = document.getElementById('menu-icon');

            mobileMenuBtn.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
                if (mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                } else {
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-times');
                }
            });

            document.querySelectorAll('.mobile-link').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-times');
                    menuIcon.classList.add('fa-bars');
                });
            });

            // --- FAQ ACCORDION ---
            const faqBtns = document.querySelectorAll('.faq-btn');
            faqBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const answer = btn.nextElementSibling;
                    const icon = btn.querySelector('i');

                    // Toggle current
                    answer.classList.toggle('open');
                    icon.classList.toggle('rotate-180');
                });
            });

        });
    </script>
</body>
</html>
