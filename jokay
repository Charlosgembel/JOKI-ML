    <!-- JAVASCRIPT LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // --- CONSTANTS & CONFIG ---
            const ADMIN_WA = '6285607706391';

            // Elements
            const startRankSelect = document.getElementById('startRank');
            const startStarInput = document.getElementById('startStar');
            const targetStarInput = document.getElementById('targetStar');
            const extReqHero = document.getElementById('extReqHero');
            const extMabar = document.getElementById('extMabar');
            const extExpress = document.getElementById('extExpress');
            const extStream = document.getElementById('extStream');

            const summaryRank = document.getElementById('summaryRank');
            const summaryStars = document.getElementById('summaryStars');
            const summaryBasePrice = document.getElementById('summaryBasePrice');
            const summaryExtra = document.getElementById('summaryExtra');
            const summaryTime = document.getElementById('summaryTime');
            const totalPriceDisplay = document.getElementById('totalPrice');
            const btnOrderWa = document.getElementById('btnOrderWa');

            // --- CALCULATOR CALCULATION LOGIC ---
            function calculatePrice() {
                const selectedOption = startRankSelect.options[startRankSelect.selectedIndex];
                const rankName = selectedOption.value;
                const pricePerStar = parseInt(selectedOption.getAttribute('data-price')) || 0;

                let startStar = parseInt(startStarInput.value) || 0;
                let targetStar = parseInt(targetStarInput.value) || 0;

                // Validation: Target cannot be less than start star
                if (targetStar <= startStar) {
                    targetStar = startStar + 1;
                    targetStarInput.value = targetStar;
                }

                const totalStarsNeeded = targetStar - startStar;
                const basePrice = totalStarsNeeded * pricePerStar;

                // Extra percentage multipliers
                let extraPercentage = 0;
                let extraDetails = [];

                if (extReqHero.checked) {
                    extraPercentage += 0.10;
                    extraDetails.push('Request Hero (+10%)');
                }
                if (extMabar.checked) {
                    extraPercentage += 0.25;
                    extraDetails.push('Main Bareng (+25%)');
                }
                if (extExpress.checked) {
                    extraPercentage += 0.15;
                    extraDetails.push('Express VIP (+15%)');
                }
                if (extStream.checked) {
                    extraPercentage += 0.10;
                    extraDetails.push('Live Stream (+10%)');
                }

                const extraPrice = Math.round(basePrice * extraPercentage);
                const grandTotal = basePrice + extraPrice;

                // Estimated time calculation
                let timeEstimate = '1 - 3 Jam';
                if (totalStarsNeeded > 15) {
                    timeEstimate = '1 - 2 Hari';
                } else if (totalStarsNeeded > 8) {
                    timeEstimate = '4 - 8 Jam';
                } else if (totalStarsNeeded > 4) {
                    timeEstimate = '2 - 5 Jam';
                }

                // Update UI Summary
                summaryRank.textContent = rankName;
                summaryStars.textContent = `${totalStarsNeeded} Bintang (${startStar} ➔ ${targetStar})`;
                summaryBasePrice.textContent = `Rp ${basePrice.toLocaleString('id-ID')}`;
                summaryExtra.textContent = extraPrice > 0 ? `+ Rp ${extraPrice.toLocaleString('id-ID')}` : 'Rp 0';
                summaryTime.textContent = timeEstimate;
                totalPriceDisplay.textContent = `Rp ${grandTotal.toLocaleString('id-ID')}`;

                return {
                    rankName,
                    startStar,
                    targetStar,
                    totalStarsNeeded,
                    basePrice,
                    extraPrice,
                    grandTotal,
                    extraDetails,
                    timeEstimate
                };
            }

            // Listeners for inputs
            [startRankSelect, startStarInput, targetStarInput, extReqHero, extMabar, extExpress, extStream].forEach(elem => {
                elem.addEventListener('change', calculatePrice);
                elem.addEventListener('input', calculatePrice);
            });

            // Preset Selection from Pricelist
            window.selectRankPreset = function(rank, price) {
                for (let i = 0; i < startRankSelect.options.length; i++) {
                    if (startRankSelect.options[i].value.toLowerCase().includes(rank.toLowerCase())) {
                        startRankSelect.selectedIndex = i;
                        break;
                    }
                }
                startStarInput.value = 0;
                targetStarInput.value = 5;
                calculatePrice();

                // Scroll smoothly to calculator
                document.getElementById('kalkulator').scrollIntoView({ behavior: 'smooth' });
            };

            // --- SEND WHATSAPP ORDER FORMAT ---
            btnOrderWa.addEventListener('click', function() {
                const data = calculatePrice();

                const accId = document.getElementById('accId').value.trim() || '-';
                const accServer = document.getElementById('accServer').value.trim() || '-';
                const accNickname = document.getElementById('accNickname').value.trim() || '-';
                const accLoginType = document.getElementById('accLoginType').value;
                const buyerWa = document.getElementById('buyerWa').value.trim() || '-';

                const extraText = data.extraDetails.length > 0 ? data.extraDetails.join(', ') : 'Tidak Ada';

                // Save automatically into Admin Recap Log
                saveOrderToRecap({
                    id: 'ORD-' + Date.now().toString().slice(-6),
                    timestamp: new Date().toLocaleString('id-ID'),
                    nick: accNickname,
                    gameId: `${accId} (${accServer})`,
                    rankDetails: `${data.rankName} (${data.startStar} ➔ ${data.targetStar} ⭐)`,
                    totalPrice: data.grandTotal,
                    payStatus: 'Belum Bayar',
                    jokiStatus: 'Pending',
                    notes: `Login: ${accLoginType} | Extra: ${extraText} | WA: ${buyerWa}`
                });

                const waMessage = 
`*FORMAT ORDER JOKI BINTANG MLBB*
---------------------------------------
🏆 *Rank Saat Ini:* ${data.rankName}
⭐ *Jumlah Bintang:* ${data.totalStarsNeeded} Bintang (${data.startStar} ➔ ${data.targetStar})
⚡ *Fitur Ekstra:* ${extraText}
⏱️ *Estimasi Waktu:* ${data.timeEstimate}
---------------------------------------
🎮 *User ID (Server):* ${accId} (${accServer})
👤 *Nickname:* ${accNickname}
🔐 *Login Via:* ${accLoginType}
📱 *WA Pembeli:* ${buyerWa}
---------------------------------------
💰 *TOTAL BIAYA:* *Rp ${data.grandTotal.toLocaleString('id-ID')}*
---------------------------------------
Halo Admin, saya ingin melanjutkan pesanan joki bintang di atas. Mohon konfirmasi rekening/QRIS pembayaran. Terima kasih!`;

                const encodedMessage = encodeURIComponent(waMessage);
                window.open(`https://wa.me/${ADMIN_WA}?text=${encodedMessage}`, '_blank');
            });

            // --- ADMIN RECAP ENGINE (LOCALSTORAGE) ---
            const DEFAULT_PIN = '1234';
            const STORAGE_KEY = 'jokistar_recap_orders_v1';

            function getRecapOrders() {
                try {
                    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
                } catch(e) {
                    return [];
                }
            }

            function saveOrderToRecap(orderObj) {
                const orders = getRecapOrders();
                orders.unshift(orderObj);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
                renderRecapTable();
            }

            function updateOrderInRecap(id, key, newValue) {
                const orders = getRecapOrders();
                const idx = orders.findIndex(o => o.id === id);
                if (idx !== -1) {
                    orders[idx][key] = newValue;
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
                    renderRecapTable();
                }
            }

            function deleteOrderFromRecap(id) {
                if (!confirm('Hapus item rekapan pesanan ini?')) return;
                let orders = getRecapOrders();
                orders = orders.filter(o => o.id !== id);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
                renderRecapTable();
            }

            function renderRecapTable() {
                const orders = getRecapOrders();
                const tbody = document.getElementById('recapTableBody');
                const emptyState = document.getElementById('recapEmptyState');
                const searchQuery = document.getElementById('recapSearch').value.toLowerCase();
                const filterStatus = document.getElementById('recapFilterStatus').value;

                tbody.innerHTML = '';

                // Stats calculation
                let totalOmset = 0;
                let countProses = 0;
                let countSelesai = 0;

                orders.forEach(o => {
                    totalOmset += parseInt(o.totalPrice) || 0;
                    if (o.jokiStatus === 'Proses') countProses++;
                    if (o.jokiStatus === 'Selesai') countSelesai++;
                });

                document.getElementById('statTotalOmset').textContent = `Rp ${totalOmset.toLocaleString('id-ID')}`;
                document.getElementById('statTotalOrder').textContent = `${orders.length} Order`;
                document.getElementById('statProses').textContent = `${countProses} Joki`;
                document.getElementById('statSelesai').textContent = `${countSelesai} Done`;

                // Filter & Search Logic
                const filtered = orders.filter(o => {
                    const matchesSearch = (o.nick || '').toLowerCase().includes(searchQuery) || 
                                          (o.gameId || '').toLowerCase().includes(searchQuery) ||
                                          (o.id || '').toLowerCase().includes(searchQuery);
                    const matchesStatus = filterStatus === 'ALL' || o.jokiStatus === filterStatus;
                    return matchesSearch && matchesStatus;
                });

                if (filtered.length === 0) {
                    emptyState.classList.remove('hidden');
                    return;
                } else {
                    emptyState.classList.add('hidden');
                }

                filtered.forEach(o => {
                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-slate-900/60 transition-colors";

                    // Color Badges
                    const payBadge = o.payStatus === 'Lunas' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : 
                                    (o.payStatus === 'DP' ? 'bg-amber-500/20 text-amber-400 border-amber-500/30' : 'bg-rose-500/20 text-rose-400 border-rose-500/30');

                    const jokiBadge = o.jokiStatus === 'Selesai' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' :
                                     (o.jokiStatus === 'Proses' ? 'bg-amber-500/20 text-amber-400 border-amber-500/30' : 'bg-slate-800 text-slate-400 border-slate-700');

                    tr.innerHTML = `
                        <td class="px-4 py-3">
                            <div class="font-mono text-[11px] text-cyan-400 font-bold">${o.id}</div>
                            <div class="text-[10px] text-slate-500">${o.timestamp}</div>
                        </td>
                        <td class="px-4 py-3">
                            <div class="font-bold text-white">${o.nick || 'No Nick'}</div>
                            <div class="text-[10px] text-slate-400"><i class="fas fa-gamepad text-slate-600 mr-1"></i>${o.gameId || '-'}</div>
                        </td>
                        <td class="px-4 py-3">
                            <div class="font-medium text-slate-200">${o.rankDetails}</div>
                            <div class="text-[10px] text-slate-500 truncate max-w-[180px]" title="${o.notes}">${o.notes || '-'}</div>
                        </td>
                        <td class="px-4 py-3 font-bold text-white">
                            Rp ${(parseInt(o.totalPrice) || 0).toLocaleString('id-ID')}
                        </td>
                        <td class="px-4 py-3">
                            <select onchange="window.changePayStatus('${o.id}', this.value)" class="text-[10px] font-bold px-2 py-1 rounded-lg border ${payBadge} bg-slate-950 focus:outline-none">
                                <option value="Belum Bayar" ${o.payStatus === 'Belum Bayar' ? 'selected' : ''}>Belum Bayar</option>
                                <option value="DP" ${o.payStatus === 'DP' ? 'selected' : ''}>DP</option>
                                <option value="Lunas" ${o.payStatus === 'Lunas' ? 'selected' : ''}>Lunas</option>
                            </select>
                        </td>
                        <td class="px-4 py-3">
                            <select onchange="window.changeJokiStatus('${o.id}', this.value)" class="text-[10px] font-bold px-2 py-1 rounded-lg border ${jokiBadge} bg-slate-950 focus:outline-none">
                                <option value="Pending" ${o.jokiStatus === 'Pending' ? 'selected' : ''}>Pending</option>
                                <option value="Proses" ${o.jokiStatus === 'Proses' ? 'selected' : ''}>Proses</option>
                                <option value="Selesai" ${o.jokiStatus === 'Selesai' ? 'selected' : ''}>Selesai</option>
                            </select>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <button onclick="window.removeOrder('${o.id}')" class="p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500 text-rose-400 hover:text-white transition-colors">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            // Expose globally for inline event handlers
            window.changePayStatus = function(id, val) { updateOrderInRecap(id, 'payStatus', val); };
            window.changeJokiStatus = function(id, val) { updateOrderInRecap(id, 'jokiStatus', val); };
            window.removeOrder = function(id) { deleteOrderFromRecap(id); };

            // Input Event Filter Listeners
            document.getElementById('recapSearch').addEventListener('input', renderRecapTable);
            document.getElementById('recapFilterStatus').addEventListener('change', renderRecapTable);

            // Manual Order Form Toggle & Submit
            const btnNewManualOrder = document.getElementById('btnNewManualOrder');
            const manualOrderModal = document.getElementById('manualOrderModal');
            const btnCloseManualForm = document.getElementById('btnCloseManualForm');
            const btnSaveManualOrder = document.getElementById('btnSaveManualOrder');

            btnNewManualOrder.addEventListener('click', () => manualOrderModal.classList.remove('hidden'));
            btnCloseManualForm.addEventListener('click', () => manualOrderModal.classList.add('hidden'));

            btnSaveManualOrder.addEventListener('click', function() {
                const nick = document.getElementById('mNick').value.trim();
                const gameId = document.getElementById('mId').value.trim();
                const rank = document.getElementById('mRank').value.trim();
                const price = document.getElementById('mPrice').value;
                const payStatus = document.getElementById('mPayStatus').value;
                const jokiStatus = document.getElementById('mJokiStatus').value;
                const notes = document.getElementById('mNotes').value.trim();

                if (!nick || !price) {
                    alert('Mohon isi minimal Nickname dan Total Harga!');
                    return;
                }

                saveOrderToRecap({
                    id: 'MAN-' + Date.now().toString().slice(-6),
                    timestamp: new Date().toLocaleString('id-ID'),
                    nick: nick,
                    gameId: gameId || '-',
                    rankDetails: rank || 'Custom Joki',
                    totalPrice: parseInt(price) || 0,
                    payStatus: payStatus,
                    jokiStatus: jokiStatus,
                    notes: notes || 'Manual Input Admin'
                });

                // Clear input
                document.getElementById('mNick').value = '';
                document.getElementById('mId').value = '';
                document.getElementById('mRank').value = '';
                document.getElementById('mPrice').value = '';
                document.getElementById('mNotes').value = '';
                manualOrderModal.classList.add('hidden');
            });

            // Action Buttons: Copy Group Log, Download Txt, Reset
            document.getElementById('btnCopyGroupLog').addEventListener('click', function() {
                const orders = getRecapOrders();
                if (orders.length === 0) {
                    alert('Belum ada rekapan untuk disalin!');
                    return;
                }

                let text = `📋 *REKAPAN ORDERAN JOKISTAR MLBB - ${new Date().toLocaleDateString('id-ID')}*\n`;
                text += `===================================\n\n`;

                orders.forEach((o, i) => {
                    text += `${i+1}. *${o.nick}* (${o.gameId})\n`;
                    text += `   • Rank: ${o.rankDetails}\n`;
                    text += `   • Harga: Rp ${parseInt(o.totalPrice).toLocaleString('id-ID')} [${o.payStatus}]\n`;
                    text += `   • Status Joki: *${o.jokiStatus.toUpperCase()}*\n`;
                    if (o.notes) text += `   • Ket: ${o.notes}\n`;
                    text += `-----------------------------------\n`;
                });

                document.execCommand('copy');
                // Temporary copy implementation fallback
                const tempTextArea = document.createElement("textarea");
                tempTextArea.value = text;
                document.body.appendChild(tempTextArea);
                tempTextArea.select();
                document.execCommand("copy");
                document.body.removeChild(tempTextArea);

                alert('Rekapan berhasil disalin ke clipboard! Silakan paste/tempel di grup WhatsApp Joki.');
            });

            document.getElementById('btnExportTxt').addEventListener('click', function() {
                const orders = getRecapOrders();
                let txtContent = `LAPORAN REKAPAN JOKI BINTANG MLBB\nDownloaded: ${new Date().toLocaleString('id-ID')}\n=========================================\n\n`;
                orders.forEach((o, i) => {
                    txtContent += `[${i+1}] ID REKAP: ${o.id} | ${o.timestamp}\n`;
                    txtContent += `Nickname: ${o.nick} | Game ID: ${o.gameId}\n`;
                    txtContent += `Rincian Rank: ${o.rankDetails}\n`;
                    txtContent += `Harga: Rp ${parseInt(o.totalPrice).toLocaleString('id-ID')} | Status Bayar: ${o.payStatus}\n`;
                    txtContent += `Status Joki: ${o.jokiStatus} | Notes: ${o.notes}\n`;
                    txtContent += `-----------------------------------------\n`;
                });

                const blob = new Blob([txtContent], { type: 'text/plain;charset=utf-8' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Rekapan_JokiStar_${Date.now()}.txt`;
                a.click();
