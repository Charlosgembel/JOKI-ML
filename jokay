            document.getElementById('btnResetAllRecap').addEventListener('click', function() {
                if (confirm('Apakah Anda yakin ingin MENGHAPUS SEMUA REKAPAN PESANAN? Data yang dihapus tidak bisa dikembalikan.')) {
                    localStorage.removeItem(STORAGE_KEY);
                    renderRecapTable();
                }
            });

